# Skopiuj do .env i uzupełnij. Plik .env jest w .gitignore i nie wchodzi do gita.

# --- lokalny MongoDB (docker-compose, TLS + SCRAM) ---
MONGO_ROOT_USER=admin
# hasło wpisz tylko we własnym .env, nigdy tutaj
MONGO_ROOT_PASSWORD=
# np. mongodb://admin:HASLO@localhost:27017/?authSource=admin  (TLS włącza klient, patrz scripts/check_mongo_tls.py)
LOCAL_MONGO_URI=
# plik CA wygenerowany przez scripts/gen_certs.sh, np. certs/ca.pem
LOCAL_MONGO_CA=

# --- Atlas M0 (mongodb+srv://...), wpisuje użytkownik ---
ATLAS_URI=

# --- dane Lichess ---
PGN_URL=https://database.lichess.org/standard/lichess_db_standard_rated_2026-09.pgn.zst
HDFS_PATH=/user/chess/raw/lichess_2026-09.pgn
DEV_MAX_BYTES=50000000
FULL_MIN_BYTES=5500000000
